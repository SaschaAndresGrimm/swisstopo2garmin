# ---------------------------------------------------------------------------
# Label assignment. mkgmap takes labels from the `name` tag, and --name-tag-list
# does NOT populate it from arbitrary source tags -- an explicit action is required
# (verified in Milestone 0; see docs/m0-findings.md). A rule with actions but no
# [type] performs the action and falls through to the rules below.
# ---------------------------------------------------------------------------
# The name, and the same value as `mkgmap:street` -- which is what
# `--housenumbers` matches an address point's `addr:street` against, within 150 m.
# Without it every address is indexed with no street to belong to.
tlm:strassenname=* { name '${tlm:strassenname}'; set mkgmap:street='${tlm:strassenname}' }
tlm:name=*         { name '${tlm:name}' }

# swissTLM3D -> Garmin line types.
# Layer and attribute names verified against docs/tlm3d-schema.md (CLAUDE.md rule 2).
# Roads carry road_class and road_speed and the map is routable when the recipe
# asks for it (SPEC.md §16 v2). Types are unchanged by that: routing rides on the
# same standard Garmin types the cartography already used, which is why it was
# possible at all -- an extended type cannot be a road.

# ---------------------------------------------------------------------------
# Hiking network -- the flagship feature (SPEC.md FR-CART3).
# Swiss trail classification, rendered with extended types defined in the TYP file:
#   Wanderweg       yellow        0x10101
#   Bergwanderweg   red/white     0x10102
#   Alpinwanderweg  blue/white    0x10103
# Matched before the generic road rules so trails win over their base geometry.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Routing (SPEC.md §16 v2). Everything here is action-only and falls through to
# the type rules below, which carry road_class and road_speed.
#
# swissTLM3D has all of it: verkehrsbeschraenkung (legal restriction),
# befahrbarkeit (drivable at all), richtungsgetrennt (one direction per
# geometry), kunstbaute (bridge/tunnel/steps), belagsart (surface) and stufe
# (level). Values are from docs/tlm3d-schema.md; none is invented.
# ---------------------------------------------------------------------------

# One direction per geometry, and the geometry runs the way traffic does.
# Verified against the data rather than assumed -- see docs/routing.md: motorway
# ramps agree with travel direction in 100% of the cases clear enough to judge.
tlm:richtungsgetrennt=Wahr { add oneway=yes }

# Legal restrictions. "Allgemeine Verkehrsbeschraenkung" is the common one --
# 127,868 of them, mostly forest and farm tracks where motor traffic needs
# permission -- so it becomes a through-route ban rather than a hard closure,
# which keeps the road usable as a destination and out of transit routes.
tlm:verkehrsbeschraenkung='Allgemeine Verkehrsbeschraenkung' { add motor_vehicle=private }
tlm:verkehrsbeschraenkung='Allgemeines Fahrverbot'           { add motor_vehicle=no }
tlm:verkehrsbeschraenkung='Zeitlich geregelt'                { add motor_vehicle=private }
tlm:verkehrsbeschraenkung=Gesperrt                           { add access=no }
tlm:verkehrsbeschraenkung=Militaerstrasse                    { add access=no; add foot=yes }
tlm:verkehrsbeschraenkung=Panzerpiste                        { add access=no; add foot=yes }
tlm:verkehrsbeschraenkung=Teststrecke                        { add access=no }
tlm:verkehrsbeschraenkung=Rennstrecke                        { add access=no }
# A secured climbing pitch is not a path anybody should be routed along.
tlm:verkehrsbeschraenkung='Gesicherte Kletterpartie'         { add access=no }

# Not drivable by a vehicle, whatever its width suggests.
tlm:befahrbarkeit=Falsch { add motor_vehicle=no }

# Structures. Steps are walkable and nothing else; a ford is passable on foot.
tlm:kunstbaute~'Bruecke.*'          { add bridge=yes }
tlm:kunstbaute='Gedeckte Bruecke'   { add bridge=yes }
tlm:kunstbaute=Steg                 { add bridge=yes; add motor_vehicle=no }
tlm:kunstbaute=Tunnel               { add tunnel=yes }
tlm:kunstbaute=Galerie              { add tunnel=yes }
tlm:kunstbaute~'Unterfuehrung.*'    { add tunnel=yes }
tlm:kunstbaute~'.*Treppe.*'         { add foot=yes; add motor_vehicle=no; add bicycle=no }
tlm:kunstbaute=Furt                 { add foot=yes; add motor_vehicle=no }

# Surface and level. Garmin uses the unpaved flag when avoiding rough roads, and
# the level keeps a bridge from connecting to what passes underneath it.
tlm:belagsart=Natur { add mkgmap:unpaved=1 }
tlm:stufe=*         { add layer='${tlm:stufe}' }

# A ferry is a route, not a road.
tlm:objektart=Faehre { add mkgmap:ferry=1; add motor_vehicle=yes }

# --- the tags above, as the travel modes mkgmap actually reads ---------------
#
# mkgmap resolves plain OSM access tags only in its own default style; a custom
# style has to do it. Written out rather than guessed: the tag names come from
# mkgmap's own styles/default/inc/access.
access=no {
  add mkgmap:foot=no; add mkgmap:bicycle=no; add mkgmap:car=no;
  add mkgmap:truck=no; add mkgmap:bus=no; add mkgmap:taxi=no;
  add mkgmap:delivery=no; add mkgmap:emergency=no
}
motor_vehicle=no {
  add mkgmap:car=no; add mkgmap:truck=no; add mkgmap:bus=no;
  add mkgmap:taxi=no; add mkgmap:delivery=no
}
# Reachable as a destination, not usable as a shortcut.
motor_vehicle=private { add mkgmap:throughroute=no }
bicycle=no            { add mkgmap:bicycle=no }
# `set`, not `add`: this overrides a blanket closure above, which is the point.
foot=yes              { set mkgmap:foot=yes }

# A closed one-way has no through traffic to check for a dead end.
oneway=yes & access=no { add mkgmap:dead-end-check=false }

tlm:wanderwege=Alpinwanderweg  [0x10103 resolution 22 continue with_actions]
tlm:wanderwege=Bergwanderweg   [0x10102 resolution 21 continue with_actions]
tlm:wanderwege=Wanderweg       [0x10101 resolution 20 continue with_actions]

# Via ferrata
tlm:objektart=Klettersteig     [0x10104 resolution 22]

# ---------------------------------------------------------------------------
# Road network, by TLM objektart
# ---------------------------------------------------------------------------
tlm:objektart=Autobahn                          [0x01 road_class=4 road_speed=7 resolution 17]
tlm:objektart=Autostrasse                       [0x02 road_class=4 road_speed=5 resolution 18]
tlm:objektart='10m Strasse'                     [0x03 road_class=3 road_speed=4 resolution 18]
tlm:objektart='8m Strasse'                      [0x04 road_class=2 road_speed=4 resolution 19]
tlm:objektart='6m Strasse'                      [0x05 road_class=2 road_speed=3 resolution 19]
tlm:objektart='4m Strasse'                      [0x06 road_class=1 road_speed=3 resolution 20]
tlm:objektart='3m Strasse'                      [0x06 road_class=1 road_speed=2 resolution 21]
tlm:objektart='2m Weg'                          [0x0a road_class=0 road_speed=1 resolution 22]
tlm:objektart='1m Weg'                          [0x16 road_class=0 road_speed=0 resolution 23]
tlm:objektart='1m Wegfragment'                  [0x16 road_class=0 road_speed=0 resolution 24]
tlm:objektart='2m Wegfragment'                  [0x16 road_class=0 road_speed=0 resolution 24]
tlm:objektart='Markierte Spur'                  [0x16 road_class=0 road_speed=0 resolution 23]
tlm:objektart=Verbindung                        [0x07 road_class=0 road_speed=1 resolution 22]
tlm:objektart=Zufahrt                           [0x07 road_class=0 road_speed=1 resolution 22]
tlm:objektart=Dienstzufahrt                     [0x07 road_class=0 road_speed=1 resolution 22]
tlm:objektart=Einfahrt                          [0x08 road_class=3 road_speed=3 resolution 21]
tlm:objektart=Ausfahrt                          [0x08 road_class=3 road_speed=3 resolution 21]
tlm:objektart=Platz                             [0x07 road_class=0 road_speed=1 resolution 21]
tlm:objektart=Faehre                            [0x1a road_class=0 road_speed=1 resolution 18]

# ---------------------------------------------------------------------------
# Rail
# ---------------------------------------------------------------------------
tlm:layer=tlm_oev_eisenbahn                     [0x14 resolution 18]

# ---------------------------------------------------------------------------
# Lifts and cableways (tlm_oev_uebrige_bahn)
# Mountain transport is essential context on a Swiss hiking or ski map, and the
# Landeskarte draws it prominently.
# ---------------------------------------------------------------------------
tlm:objektart=Luftseilbahn                      [0x10105 resolution 19]
tlm:objektart=Gondelbahn                        [0x10105 resolution 19]
tlm:objektart=Sesselbahn                        [0x10105 resolution 20]
tlm:objektart=Skilift                           [0x10106 resolution 21]
tlm:objektart=Foerderband                       [0x10106 resolution 22]
tlm:objektart=Transportseil                     [0x10106 resolution 22]
tlm:objektart=Lift                              [0x10106 resolution 22]

# ---------------------------------------------------------------------------
# Hydrography
# ---------------------------------------------------------------------------
# swissTLM3D's watercourse layer carries topological constructs and buried
# watercourses that the Landeskarte does not draw. Excluding them removes the long
# straight blue lines that otherwise cut across lakes and glaciers:
#   Seeachse              lake axis -- a connectivity line through a water body
#   Druckstollen/-leitung pressure tunnels and penstocks (underground)
#   verlauf=Unterirdisch* piped or subterranean sections
# `deletealltags` is the mkgmap idiom for dropping an element: with no tags left,
# no later rule can match it. There is no "type 0x00 means discard".
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:objektart=Seeachse         { deletealltags }
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:objektart=Druckstollen     { deletealltags }
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:objektart~'Druckleitung.*' { deletealltags }
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:verlauf~'Unterirdisch.*'   { deletealltags }
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:objektart=Trockenrinne      [0x18 resolution 23]
tlm:layer=tlm_gewaesser_fliessgewaesser & tlm:name=*                      [0x1f resolution 19]
tlm:layer=tlm_gewaesser_fliessgewaesser                                   [0x18 resolution 21]
tlm:layer=tlm_gewaesser_stehendes_gewaesser                               [0x1f resolution 19]

# ---------------------------------------------------------------------------
# Contour lines from swissALTI3D (SPEC.md FR-CART5).
# Tagging convention emitted by the contour stage (FR-P6), chosen to match the
# wider mkgmap style ecosystem so third-party styles stay compatible.
# Garmin native contour types: 0x20 minor, 0x21 intermediate, 0x22 major.
# Only index (major) contours are labelled, to keep the map legible.
# ---------------------------------------------------------------------------
# Blue contours over glacier and firn, as the Landeskarte does (FR-CART9).
# Must precede the generic contour rules.
contour=elevation & contour_surface=ice       [0x23 resolution 20]

contour=elevation & contour_ext=elevation_major
    { name '${ele}' }                 [0x22 resolution 18]
contour=elevation & contour_ext=elevation_medium [0x21 resolution 20]
contour=elevation & contour_ext=elevation_minor  [0x20 resolution 22]

# ---------------------------------------------------------------------------
# Winter routes (skimo preset). Sources and value domains verified against the
# real GeoPackages -- see docs/winter-schema.md.
#
# ski_network.access: 0 = skiable, 1 = on foot / carrying skis, 2 = caution.
# That distinction is the one that matters in the field, so it drives the styling.
# ---------------------------------------------------------------------------
sac:layer~'ski_network.*' & sac:discipline=ski_tour & sac:access=2  [0x10109 resolution 20]
sac:layer~'ski_network.*' & sac:discipline=ski_tour & sac:access=1  [0x10108 resolution 20]
sac:layer~'ski_network.*' & sac:discipline=ski_tour                 [0x10107 resolution 19]
sac:layer~'ski_network.*' & sac:discipline=ski_snowshoe_tour        [0x1010a resolution 20]

# Named SAC tours carry the label; the network above carries the geometry, so the
# route layer is drawn at the same weight and only adds names.
sac:layer~'ski_routes.*' { name '${sac:name}' }                     [0x10107 resolution 19]

# ASTRA / SchweizMobil signposted winter trails.
swm:layer=Schneeschuhwanderwege { name '${swm:NameR}' }             [0x1010a resolution 20]
swm:layer=Winterwanderwege      { name '${swm:NameR}' }             [0x1010b resolution 20]

# ---------------------------------------------------------------------------
# Cycling preset. Sources are ASTRA shapefiles -- see docs/routes-schema.md.
#
# VeloWeg.Netzhier looks like a network hierarchy but is empty throughout the real
# data, so the cycle network is drawn as one class. MTBWeg.IsSTrail does carry
# signal: 4,802 of 52,316 segments are singletrail.
# ---------------------------------------------------------------------------
astra:layer=MTBWeg & astra:IsSTrail=1  [0x1010e resolution 21]
astra:layer=MTBWeg                     [0x1010d resolution 20]
astra:layer=VeloWeg                    [0x1010c resolution 20]

# Named routes carry the route number as the label. All three ASTRA datasets ship a
# file called Route.shp, so the layer tag is qualified by dataset -- otherwise a
# mountain-bike route would render as a cycle route.
astra:layer=mountainbikeland_Route & astra:NrR=* { name '${astra:NrR}' } [0x1010d resolution 19]
astra:layer=veloland_Route & astra:NrR=* { name '${astra:NrR}' }         [0x1010c resolution 19]
# wanderland gives the official hiking route numbers, which swissTLM3D does not carry.
astra:layer=wanderland_Route & astra:NrR=* { name '${astra:NrR}' }       [0x10101 resolution 19]
