# Local data cache (never commit geodata)
/cache/
*.gpkg

# ...except the committed test fixture. SPEC.md §13.2 wants a commune-sized extract that
# runs the whole pipeline in CI in under a minute, and that is impossible if the extract
# is not in the repository. It never ran there: the test skipped for want of a toolchain,
# and once the toolchain arrived it failed on the missing file. 2.3 MB, once.
!crates/s2g-core/tests/fixtures/*.gpkg
*.gpkg.zip
*.gdb.zip
*.shp.zip
*.xtf.zip
*.img
*.pbf
*.osm
*.osm.pbf

# Build output
/target/
/frontend/dist/
node_modules/
/frontend/node_modules/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Vendored toolchain (fetched by vendor/fetch_tools.py, never committed)
/vendor/mkgmap*/
/vendor/splitter*/
/vendor/jdk*/
/vendor/jre*/

# Spike working dirs and outputs
/work/
/out/

# Python
__pycache__/
*.pyc

# Machine-specific toolchain paths (regenerate with vendor/fetch_tools.py)
/vendor/toolchain.env

# Compiled Java helper (built by javac from ImgDump.java)
tools/imgdump/*.class

# Tauri-generated ACL schemas (regenerated by tauri-build on every compile)
/src-tauri/gen/schemas/
