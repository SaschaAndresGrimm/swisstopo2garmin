{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swisstopo2garmin",
  "version": "0.2.0",
  "identifier": "ch.swisstopo2garmin.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "swisstopo2garmin",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://wmts.geo.admin.ch; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://data.geo.admin.ch https://wmts.geo.admin.ch"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "appimage",
      "deb"
    ],
    "copyright": "GPL-3.0-or-later. Map data © swisstopo.",
    "category": "Utility",
    "shortDescription": "Garmin maps from swisstopo open data",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../style": "style",
      "../typ": "typ",
      "../devices": "devices",
      "../estimator": "estimator",
      "../NOTICE": "NOTICE",
      "../LICENSE": "LICENSE",
      "../vendor/mkgmap-r4924": "vendor/mkgmap-r4924",
      "../vendor/splitter-r654": "vendor/splitter-r654",
      "../vendor/jre": "vendor/jre",
      "../vendor/toolchain.env": "vendor/toolchain.env"
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15",
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
